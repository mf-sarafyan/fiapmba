# ============================================================
# Quantum Finance - Consultor Financeiro Agentico
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env no GitHub.
# ============================================================

# --- Modelo ---
# O lab 32604 usa "gemini-3.5-flash". Ajuste conforme disponibilidade na sua regiao.
MODEL="gemini-2.5-flash"

# --- Vertex AI / Google Cloud ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT="seu-projeto-gcp"
GOOGLE_CLOUD_LOCATION=global
SERVICE_ACCOUNT="000000000000-compute@developer.gserviceaccount.com"

# --- Fonte de dados da B3 ---
# auto     -> tenta MCP; se falhar no boot, sobe apenas o fallback (RECOMENDADO)
# mcp      -> exige o MCP; se falhar, a aplicacao nao sobe (modo "producao estrita")
# fallback -> ignora o MCP e usa somente a API HTTP local
B3_DATA_SOURCE=auto

# MCP da Bolsai (plano free: 200 requisicoes/dia)
BOLSAI_MCP_URL="https://mcp.bolsai.com.br/mcp/"
BOLSAI_API_KEY=""

# Fallback: brapi.dev (token gratuito em https://brapi.dev)
BRAPI_TOKEN=""
BRAPI_BASE_URL="https://brapi.dev/api"
